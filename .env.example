# Public Supabase client configuration. Never add service-role credentials here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Account-email website. Change this, rebuild/redeploy, then align Supabase
# Auth Site URL, allowed redirects and email templates. See README.md.
EXPO_PUBLIC_AUTH_ORIGIN=https://squad-beacon.vercel.app

# Guest invitations: use the same exact HTTPS origin in client/server environments.
EXPO_PUBLIC_GUEST_ORIGIN=
# Server-only values belong in the deployment environment; never expose the key.
SB_GUEST_ENABLED=false
SB_PUBLIC_ORIGIN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SB_GUEST_RATE_SECRET=
# Optional verified native association credentials, also supplied to native builds.
APPLE_TEAM_ID=
ANDROID_APP_LINK_FINGERPRINTS=
