{
  "expo": {
    "name": "Squad-Beacon",
    "slug": "Squad-Beacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "squadbeacon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAT1D5KGEV99uxxB03b6OhoW5ObtrnJhOA"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Choose a contact to invite to Squad Beacon. Your address book is never uploaded."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "QuickCreateWidget",
              "displayName": "Quick Create",
              "description": "Start a Beacon, share your status, or make a Beacon Plan in the app.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "configuration": {
                  "title": "Your shortcut",
                  "parameters": {
                    "kind": {
                      "title": "Open",
                      "type": "enum",
                      "default": "beacon",
                      "values": [
                        { "name": "Beacon", "value": "beacon" },
                        { "name": "Beacon Plan", "value": "plan" },
                        { "name": "Status", "value": "status" }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "FriendsNowWidget",
              "displayName": "Friends Now",
              "description": "See who is free and which friends have an active beacon.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "configuration": {
                  "title": "Choose a circle",
                  "description": "Show everyone or one of your three circles.",
                  "parameters": {
                    "circle": {
                      "title": "Friends to show",
                      "type": "enum",
                      "default": "all",
                      "values": [
                        { "name": "All friends", "value": "all" },
                        { "name": "Circle 1", "value": "circle1" },
                        { "name": "Circle 2", "value": "circle2" },
                        { "name": "Circle 3", "value": "circle3" }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "SquadBeaconsWidget",
              "displayName": "Circle Beacons",
              "description": "A little map-like pulse of active plans in a circle.",
              "ios": {
                "supportedFamilies": ["systemMedium", "systemLarge"],
                "configuration": {
                  "title": "Choose a circle",
                  "description": "Use a circle configured in Widget Studio.",
                  "parameters": {
                    "circle": {
                      "title": "Circle",
                      "type": "enum",
                      "default": "circle1",
                      "values": [
                        { "name": "Circle 1", "value": "circle1" },
                        { "name": "Circle 2", "value": "circle2" },
                        { "name": "Circle 3", "value": "circle3" }
                      ]
                    }
                  }
                }
              }
            },
            {
              "name": "NextBeaconWidget",
              "displayName": "Next Beacon",
              "description": "Your next beacon and when it begins.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline"
                ]
              }
            },
            {
              "name": "CirclePulseWidget",
              "displayName": "Circle Pulse",
              "description": "A compact count of free friends and active beacons.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
